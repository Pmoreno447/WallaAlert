# Copia este archivo a .env y rellénalo. .env no se sube al repositorio.

# Token del bot: créalo hablando con @BotFather en Telegram (/newbot).
TELEGRAM_BOT_TOKEN=

# Tu id de usuario de Telegram: arranca el bot y envíale /id para verlo.
# Este usuario es el administrador: tiene acceso siempre y acepta o rechaza al resto.
TELEGRAM_ADMIN_ID=

# Opcional: ruta de la base de datos (por defecto, la de config.json).
# DATABASE_PATH=data/bot.db
